@baseUrl = https://tiendaonline-backend-git-dev-rhorbes-projects.vercel.app/backend

@carritoId = 69b89351fbb7da2b920d61c1
@itemId = 69b89351fbb7da2b920d61c2
@categoriaId = 69b89351fbb7da2b920d61c3
@marcaId = 69b89351fbb7da2b920d61c4
@pedidoId = 69b89351fbb7da2b920d61c5
@productoId = 69b89351fbb7da2b920d61c6
@tamanioId = 69b89351fbb7da2b920d61c7

### GET carrito
GET {{baseUrl}}/carrito
Accept: application/json

### POST carrito item
POST {{baseUrl}}/carrito/item
Accept: application/json
Content-Type: application/json

{
  "producto_id": "{{productoId}}",
  "cantidad": 1
}

### GET carrito por id
GET {{baseUrl}}/carrito/{{carritoId}}
Accept: application/json

### DELETE carrito
DELETE {{baseUrl}}/carrito/{{carritoId}}
Accept: application/json

### PUT carrito item
PUT {{baseUrl}}/carrito/{{carritoId}}/item/{{itemId}}
Accept: application/json
Content-Type: application/json

{
  "cantidad": 2
}

### DELETE carrito item
DELETE {{baseUrl}}/carrito/{{carritoId}}/item/{{itemId}}
Accept: application/json

