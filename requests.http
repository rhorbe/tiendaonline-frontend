### 1) Login y guardar JWT en variable global "token"
POST {{baseUrl}}/login
Accept: application/json
Content-Type: application/json

{
  "email": "demo@demo.com",
  "password": "demo1234"
}

> {%
    if (response.status === 200 && response.body.token) {
        client.global.set("token", response.body.token);
    } else {
        throw new Error("No se pudo obtener token JWT en /login");
    }
%}

### 2) GET VAPID public key
GET {{baseUrl}}/push/public-key
Accept: application/json
Authorization: Bearer {{token}}


### 3) POST suscripción Web Push
POST {{baseUrl}}/push/subscribe
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "endpoint": "{{webPushEndpoint}}",
  "expirationTime": null,
  "keys": {
    "p256dh": "BGN53YsJBzbE-4eskwRBFMw2XrDBreb2ytl1bL2h6a_z7EvVERHT-MfPL3-nRTdLruUqO1zqDsln0q4hqXJlPXE",
    "auth": "hqDmCTLXZJBTZepQMbI8nA"
  }
}


### 4) POST webpush unsubscribe
POST {{baseUrl}}/push/unsubscribe
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "endpoint": "{{webPushEndpoint}}"
}

### 5) POST webpush test
POST {{baseUrl}}/push/test
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "Notificación de prueba",
  "body": "Hola desde Laravel WebPush"
}